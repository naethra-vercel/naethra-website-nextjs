# Public WordPress REST API base (no trailing slash required)
NEXT_PUBLIC_WORDPRESS_API_URL=https://example.com/wp-json/wp/v2

# Contact Form 7 reCAPTCHA v3 site key (secret stays in WordPress)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# WordPress credentials for private/authenticated use only — keep in local .env
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=your-wordpress-username
WORDPRESS_APP_PASSWORD=your-wordpress-application-password

# Gemini API key for Naethra Assistant (server-only — never expose as NEXT_PUBLIC_*)
GEMINI_API_KEY=your-gemini-api-key

# Instantly API v2 key (server-only)
INSTANTLY_API_KEY=your_api_key_here

# Bearer token required by this app's private /api/instantly management routes
INSTANTLY_ADMIN_TOKEN=replace_with_a_long_random_secret

# Bearer token Instantly must send to POST /api/webhooks/instantly
INSTANTLY_WEBHOOK_SECRET=replace_with_a_long_random_secret
